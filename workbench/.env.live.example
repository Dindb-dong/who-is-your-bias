# Copy to .env.live only for a configured provider test. The file is read by 로컬페르소나시연.command.
# With the settings below, language and voice use the local Qwen models.
BIAS_ADAPTIVE_RESPONSES=true

# Optional reviewed project/news QA. Use an absolute path from the updated
# checkout; also rebuild that checkout's frontend. This is retrieval, not training.
# BIAS_QA_KNOWLEDGE_DIR=/absolute/path/to/who-is-your-bias/data/qa

# Optional Korean captions beside English voice (?bilingual=1&present=1).
# BIAS_TRANSLATION_PROTOCOL=openai-compatible
# Use a non-thinking Chat Completions model. A separate fast service avoids
# competing with an answer model that serializes local requests.
# BIAS_TRANSLATION_BASE_URL=http://127.0.0.1:8120/v1
# BIAS_TRANSLATION_MODEL=your-translation-model
# BIAS_TRANSLATION_API_KEY=
# BIAS_TRANSLATION_TIMEOUT=12
# Alternatively, use google-web for the keyless Orbit-compatible endpoint or
# google-cloud with BIAS_TRANSLATION_API_KEY for official Cloud Basic v2.
# Google receives only the finalized English answer segment. Google modes
# default to a 2.5 second deadline. Rehearse on the venue network.

# Optional OpenAI-compatible Chat Completions provider. Set both URL and model.
# BIAS_LLM_BASE_URL=https://api.openai.com/v1
# BIAS_LLM_MODEL=your-chat-model
# BIAS_LLM_API_KEY=your-api-key
# BIAS_LLM_TOKEN_LIMIT_FIELD=max_completion_tokens

# Optional OpenAI-compatible speech provider. It must return WAV from /audio/speech.
# BIAS_TTS_BASE_URL=https://api.openai.com/v1
# BIAS_TTS_MODEL=your-speech-model
# BIAS_TTS_API_KEY=your-api-key
# BIAS_TTS_VOICE=your-voice-id
# BIAS_TTS_PERSONA_ID=generic

# Optional ElevenLabs. Use a voice already available to your account.
# YAICON_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional server transcription. The app submits one recording when the mic is stopped.
# BIAS_ASR_BASE_URL=https://api.openai.com/v1
# BIAS_ASR_MODEL=your-transcription-model
# BIAS_ASR_API_KEY=your-api-key
