# Leave providers empty to run the source-evidence preview without model credentials.
# Copy this file to .env, then run: uv run --env-file .env bias serve
BIAS_LLM_BASE_URL=
BIAS_LLM_MODEL=
BIAS_LLM_API_KEY=
BIAS_LLM_MAX_TOKENS=900
# Set this to the selected model's actual context window.
BIAS_LLM_CONTEXT_WINDOW=8192
# Optional matching local tokenizer with a chat template. Without it, the API
# reports a conservative UTF-8 byte budget, not measured model token usage.
BIAS_LLM_TOKENIZER_PATH=

# Local Ollama example: base URL http://127.0.0.1:11434/v1 and an installed model name.
# Any provider must implement the OpenAI chat/completions streaming protocol.

# Optional reference-voice service, configured separately in services/voice/.env.example.
# BIAS_TTS_BASE_URL=http://127.0.0.1:8010/v1
# BIAS_TTS_MODEL=qwen3-tts
# BIAS_TTS_VOICE=reference
# BIAS_TTS_PERSONA_ID=jensen-huang
# BIAS_TTS_LANGUAGE_HINT=true
BIAS_TTS_BASE_URL=
BIAS_TTS_MODEL=
BIAS_TTS_API_KEY=
BIAS_TTS_VOICE=default
# Required before server voice playback: active persona ID, or generic for a
# non-person-specific voice. Never label an old Musk reference as Jensen.
BIAS_TTS_PERSONA_ID=
# Enable only for the local Qwen service; generic endpoints may reject this extension.
BIAS_TTS_LANGUAGE_HINT=false

# Optional measured-motion library. Chat defaults to designed motion even when loaded.
# BIAS_MOTION_CATALOG=data/motion/elon-musk-ted-v1.json
# BIAS_MOTION_ASSET_ROOT=apps/web/public
BIAS_MOTION_CATALOG=

# Optional Rhubarb Lip Sync executable. Audio remains playable without it.
# English uses PocketSphinx plus dialogue hints; other languages use phonetic recognition.
BIAS_LIPSYNC_BIN=
BIAS_LIPSYNC_TIMEOUT=30
BIAS_LIPSYNC_THREADS=2

# Optional OpenAI-compatible audio/transcriptions server.
BIAS_ASR_BASE_URL=
BIAS_ASR_MODEL=
BIAS_ASR_API_KEY=

BIAS_REQUEST_TIMEOUT=60
BIAS_SESSION_TTL=3600
BIAS_MAX_SESSIONS=256
BIAS_MAX_TURNS=12
BIAS_RETRIEVAL_LIMIT=4
# The default studio uses data/personas/jensen-huang and its registered snapshot.
# It contains dated 2024-2025 summaries; the 2026 cutoff is not current coverage.
# To reproduce the historical Musk pilot, set BOTH explicitly:
# BIAS_CORPUS_DIR=data/qna/elon-musk-v1
# BIAS_PERSONA_SNAPSHOT=data/snapshots/elon-musk-2026-11-11.json
# Custom corpora require their own exact snapshot: see docs/persona-data.md.
# BIAS_CORPUS_DIR=data/local/persona-2026/corpus
# BIAS_PERSONA_SNAPSHOT=data/local/persona-2026/snapshot.json
# An explicitly empty BIAS_PERSONA_SNAPSHOT disables the temporal runtime policy
# for historical reproduction; leave this variable unset for the default studio.

# Hybrid retrieval is opt-in. Install with: uv sync --extra dev --extra hybrid
# A reproducible expanded-corpus recipe is in config/persona-2026.env.example.
BIAS_RETRIEVAL_BACKEND=lexical
BIAS_RETRIEVAL_PREWARM=true
BIAS_EMBEDDING_BACKEND=local
BIAS_EMBEDDING_MODEL=
BIAS_EMBEDDING_REVISION=
BIAS_EMBEDDING_BASE_URL=
BIAS_EMBEDDING_API_KEY=
BIAS_DENSE_MIN_SIMILARITY=0.84
BIAS_RERANKER_MODEL=
BIAS_RERANKER_REVISION=
BIAS_RERANKER_MIN_SCORE=
BIAS_STYLE_EXAMPLES=false
BIAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


