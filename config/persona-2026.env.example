# Optional research recipe, not a validated persona or production recommendation.
# Materialize the original corpus and register its exact snapshot first:
# docs/persona-data.md and docs/2026-implementation.md.
# uv sync --extra dev --extra hybrid
# uv run --env-file config/persona-2026.env.example bias serve
BIAS_CORPUS_DIR=data/local/persona-2026/corpus
BIAS_PERSONA_SNAPSHOT=data/local/persona-2026/snapshot.json
BIAS_RETRIEVAL_BACKEND=hybrid
BIAS_RETRIEVAL_PREWARM=true
BIAS_EMBEDDING_BACKEND=local
BIAS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
BIAS_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
BIAS_DENSE_MIN_SIMILARITY=0.78
BIAS_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
BIAS_RERANKER_REVISION=1427fd652930e4ba29e8149678df786c240d8825
# Development recipe; see the false-candidate results before changing this gate.
BIAS_RERANKER_MIN_SCORE=-3
BIAS_STYLE_EXAMPLES=false
BIAS_LLM_CONTEXT_WINDOW=8192
BIAS_LLM_MAX_TOKENS=900
# Leave providers unconfigured for attributed source previews. To generate new
# answers or live voice, set actual local/provider endpoints in your own .env.
BIAS_LLM_BASE_URL=
BIAS_LLM_MODEL=
BIAS_LLM_API_KEY=
BIAS_TTS_BASE_URL=
BIAS_TTS_MODEL=
BIAS_TTS_API_KEY=
BIAS_TTS_VOICE=default
BIAS_TTS_LANGUAGE_HINT=false
BIAS_REQUEST_TIMEOUT=60
# Bound CPU contention during local embedding/reranker warmup.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
