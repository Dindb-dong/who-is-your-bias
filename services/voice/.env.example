# Reference files and model weights stay local and are not bundled in the repo.
ORT_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_TELEMETRY=1
BIAS_VOICE_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
BIAS_VOICE_REVISION=5d83992436eae1d760afd27aff78a71d676296fc
# Download the pinned snapshot separately; HTTP requests are offline by default.
# BIAS_VOICE_CACHE_DIR=/absolute/path/to/huggingface/hub
BIAS_VOICE_LOCAL_FILES_ONLY=true
BIAS_VOICE_DEVICE=cuda:0
BIAS_VOICE_DTYPE=bfloat16
BIAS_VOICE_ATTENTION=sdpa
BIAS_VOICE_REFERENCE_WAV=/absolute/path/to/reviewed-reference.wav
# Select one transcript source: an accurate UTF-8 file or literal text.
BIAS_VOICE_REFERENCE_TEXT_FILE=/absolute/path/to/reference.txt
# BIAS_VOICE_REFERENCE_TEXT=Accurate text of the reference recording.
# Server-only opt-in to Qwen's speaker-embedding mode; ignores reference text.
# Leave false for the default audio-and-transcript conditioning path.
BIAS_VOICE_X_VECTOR_ONLY_MODE=false
BIAS_VOICE_MAX_INPUT_CHARS=2000
BIAS_VOICE_MAX_NEW_TOKENS=1536
BIAS_VOICE_MAX_AUDIO_SECONDS=120
BIAS_VOICE_MAX_BODY_BYTES=32768
BIAS_VOICE_THREADS=4
BIAS_VOICE_SEED=42
BIAS_VOICE_DO_SAMPLE=true
BIAS_VOICE_TEMPERATURE=0.9
BIAS_VOICE_TOP_K=50
BIAS_VOICE_TOP_P=1.0
BIAS_VOICE_REPETITION_PENALTY=1.05
# Optional bearer key; match BIAS_TTS_API_KEY in the main app when configured.
# BIAS_VOICE_API_KEY=
