BIAS_LANGUAGE_MODEL=Qwen/Qwen3-0.6B
ORT_DISABLE_TELEMETRY=1
BIAS_LANGUAGE_SERVED_MODEL=qwen3-local
BIAS_LANGUAGE_REVISION=c1899de289a04d12100db370d81485cdf75e47ca
BIAS_LANGUAGE_CACHE_DIR=/path/outside/repository/hf-cache
BIAS_LANGUAGE_LOCAL_FILES_ONLY=true
BIAS_LANGUAGE_DEVICE=cpu
# float32 is portable; bfloat16 was tested on the documented supporting CPU.
BIAS_LANGUAGE_DTYPE=float32
BIAS_LANGUAGE_THREADS=4
BIAS_LANGUAGE_MAX_INPUT_TOKENS=8192
BIAS_LANGUAGE_MAX_OUTPUT_TOKENS=1024
BIAS_LANGUAGE_GENERATION_TIMEOUT=120
# Keep credentials on the model server and main application server only.
# BIAS_LANGUAGE_API_KEY=

# Main application process; its timeout should exceed the model-server timeout.
BIAS_LLM_BASE_URL=http://127.0.0.1:8020/v1
BIAS_LLM_MODEL=qwen3-local
BIAS_LLM_MAX_TOKENS=900
BIAS_REQUEST_TIMEOUT=150
# BIAS_LLM_API_KEY=
