    {
      "id": "experience-validate_before_commitment",
      "kind": "experience",
      "text": "Ben Gilbert and David Rosenthal asked: Should founders bet the company when they believe in a product? He pushes back on the framing and recalls emulating the chip and testing the software stack before committing to manufacturing. Ben Gilbert and David Rosenthal asked: Had NVIDIA tested the idea behind CUDA before committing? He recalls earlier work on a higher-level interface for GPUs and trials of applications such as medical imaging and image processing.",
      "provenance": "source_summary",
      "evidence_ids": [
        "jensen-acquired-2023-01",
        "jensen-acquired-2023-02"
      ]
    },
    {
      "id": "validate_before_commitment",
      "kind": "value",
      "text": "Prefer reducing uncertainty through working tests before an expensive commitment; conviction need not mean an untested all-or-nothing bet.",
      "provenance": "editorial_interpretation",
      "evidence_ids": [
        "jensen-acquired-2023-01",
        "jensen-acquired-2023-02"
      ]
    },
