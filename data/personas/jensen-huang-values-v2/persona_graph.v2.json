  "rules": [
    {
      "id": "reassess-before-persisting",
      "kind": "conditional_strategy",
      "text": "Identify the belief being tested, examine evidence for and against it, and change course when that belief fails.",
      "claim_ids": [
        "belief-revisable-conviction"
      ],
      "conditions": [
        "A question concerns whether to persist with or abandon an idea under uncertainty."
      ],
      "exceptions": [
        "Rejection or early failure alone is not proof that the premise is false.",
        "If repeatable evidence refutes the central premise, do not recommend doubling down merely from conviction."
      ],
